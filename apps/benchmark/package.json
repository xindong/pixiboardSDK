{
  "name": "pixiboardjs-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic PixiBoardJS core, spatial, renderer and lifecycle benchmark harness",
  "scripts": {
    "generate:synthetic-card": "node src/generate.mjs",
    "benchmark:run": "PIXIBOARD_BENCHMARK_RUN=1 vitest run --config vitest.config.ts test/benchmark-run.test.ts --reporter=verbose",
    "benchmark:matrix": "PIXIBOARD_BENCHMARK_MATRIX=1 vitest run --config vitest.config.ts test/benchmark-matrix.test.ts --reporter=verbose",
    "benchmark:report": "PIXIBOARD_SDK_BENCHMARK_REPORT=1 vitest run --config vitest.config.ts test/sdk-report.test.ts --reporter=verbose",
    "benchmark:browser": "node src/browser-runner.mjs",
    "benchmark:browser:smoke": "PIXIBOARD_BROWSER_SMOKE=1 PIXIBOARD_BROWSER_COUNTS=10000 PIXIBOARD_BROWSER_MODES=matched-visible PIXIBOARD_BROWSER_SAMPLES=5 PIXIBOARD_BROWSER_WARMUP=2 node src/browser-runner.mjs",
    "benchmark:check": "node src/check-regression.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@pixi-board/core": "workspace:*",
    "@pixi-board/renderer-pixi": "workspace:*",
    "konva": "9.3.22",
    "pixi.js": "8.19.0",
    "pixiboardjs": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
